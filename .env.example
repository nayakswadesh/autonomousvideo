OPENAI_API_KEY=
GEMINI_API_KEY=
STUDIO_RESEARCH_MODEL=gpt-6-luna
STUDIO_DIRECTOR_MODEL=gpt-5.6-sol
STUDIO_SHORTS_RESEARCH_MODEL=gpt-6-luna
STUDIO_SHORTS_CREATIVE_MODEL=gpt-6.1-sol
STUDIO_SHORTS_REPAIR_MODEL=gpt-6-luna
STUDIO_STORY_MODEL=gpt-6.1-sol
STUDIO_CONTINUITY_MODEL=gpt-6-luna
STUDIO_VISUAL_PLAN_MODEL=gpt-6-luna
STUDIO_VISUAL_REPAIR_MODEL=gpt-6-luna
STUDIO_SEMANTIC_LAYOUT_MODEL=gpt-6-luna
STUDIO_LONGFORM_METADATA_MODEL=gpt-6-luna
STUDIO_MAX_OUTPUT_TOKENS=20000
# Shared default for newly created Shorts and long-form projects.
STUDIO_TTS_PROVIDER=gemini
STUDIO_LONGFORM_TTS_MODEL=gemini-3.8-flash-tts
STUDIO_LONGFORM_TTS_VOICE=Aoede
# OpenAI remains an alternative; existing projects retain saved providers/models.
STUDIO_TTS_MODEL=gpt-4o-mini-tts
STUDIO_VOICE=coral
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=
# v0.5: applies to newly created live topics; existing projects retain their saved policy.
STUDIO_AUTO_ASSETS=true
STUDIO_IMAGE_MODEL=gpt-image-2
STUDIO_IMAGE_QUALITY=medium
STUDIO_MAX_IMAGE_REQUESTS=2
# Productions support 1–18 (the shot limit), but never raise this without a cost decision.
STUDIO_MUSIC_CATALOG=music/youtube-audio-library.yaml
STUDIO_YOUTUBE_CATEGORY_ID=28
